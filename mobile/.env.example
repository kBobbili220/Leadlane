# This is the HTTP API address, not a PostgreSQL connection string.
# For a real phone, use your computer's Wi-Fi/LAN IPv4 address (same Wi-Fi).
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# If omitted, development builds attempt to infer the computer from Expo's LAN URL.
# For the Android emulator you can explicitly use http://10.0.2.2:8000.
# EXPO_PUBLIC_ variables are bundled into the app: never put passwords here.
