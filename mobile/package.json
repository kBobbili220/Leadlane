{
  "name": "detailflow-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "expo start --go --lan",
    "start:dev": "expo start --dev-client --lan",
    "android": "expo start --go --android",
    "android:wsl": "bash ../dev.sh",
    "ios": "expo start --go --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run check:client",
    "check:client": "node --check public/app.js && node --check public/service-client.mjs && node --check src/api/services.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.32",
    "expo-build-properties": "~57.0.23",
    "expo-constants": "~57.0.23",
    "expo-dev-client": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": { "node": ">=22.13.0" }
}
